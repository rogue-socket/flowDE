{
  "name": "flowde",
  "displayName": "FlowDE",
  "description": "Graph-based code comprehension layer for Python projects in VS Code.",
  "icon": "media/icon.png",
  "version": "0.2.0",
  "publisher": "rogue-socket",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rogue-socket/flowDE.git"
  },
  "bugs": {
    "url": "https://github.com/rogue-socket/flowDE/issues"
  },
  "homepage": "https://github.com/rogue-socket/flowDE#readme",
  "markdown": "github",
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onCommand:flowde.openGraphView"
  ],
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "python",
    "graph",
    "code navigation",
    "program analysis",
    "static analysis",
    "data-flow",
    "visualization"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flowde.openGraphView",
        "category": "FlowDE",
        "title": "FlowDE: Open Graph View"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "lint": "echo \"No lint configured yet\"",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@lezer/common": "^1.2.3",
    "@lezer/python": "^1.1.16",
    "cytoscape": "^3.29.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2"
  }
}
