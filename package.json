{
  "name": "flowde",
  "displayName": "FlowDE",
  "description": "Graph-based code comprehension layer for Python projects in VS Code.",
  "version": "0.1.0",
  "publisher": "flowde",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:flowde.openGraphView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flowde.openGraphView",
        "title": "FlowDE: Open Graph View"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "lint": "echo \"No lint configured yet\"",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@lezer/common": "^1.2.3",
    "@lezer/python": "^1.1.16",
    "cytoscape": "^3.29.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2"
  }
}
